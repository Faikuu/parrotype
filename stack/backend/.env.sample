# Database engine: sqlite (default), postgresql or mysql. DATABASE_URL must match it.
DATABASE_PROVIDER=sqlite
# SQLite paths are relative to the schema folder, prisma/sqlite/, so this is prisma/dev.db.
DATABASE_URL="file:../dev.db"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
CORS_ORIGINS=http://localhost:5173
PORT=3000
NODE_ENV=development
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (0 = none). Set to 1 behind a single proxy so
# the rate limiter keys on the client IP from X-Forwarded-For instead of the proxy's address.
TRUST_PROXY=0

# Encrypts the two-factor (TOTP) secrets at rest. Required: at least 32 characters, different from JWT_SECRET.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later makes every two-factor secret unreadable, so every user with two-factor sign-in must set it up again.
TOTP_ENCRYPTION_KEY=change-me-to-another-long-random-string-of-at-least-32-chars

# Account emails (password reset, email verification). Public origin of the web app, for the links in them.
APP_URL=http://localhost:5173
# console (default): logs each email and keeps the last 50 in memory. Development and tests only: the links are in the log.
# smtp: sends through SMTP_URL.
MAIL_TRANSPORT=console
# Required with MAIL_TRANSPORT=smtp. smtp:// for STARTTLS, smtps:// for implicit TLS (port 465).
# SMTP_URL=smtp://user:password@mail.example.com:587
MAIL_FROM="ParroType <no-reply@localhost>"

# To use PostgreSQL or MySQL/MariaDB instead, replace the two database lines above with one of these
# (see README.md, "Choosing a database"), then run `npm run prisma:generate` and `npm run prisma:deploy`:
#
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://parrotype:parrotype@localhost:5432/parrotype"
#
# DATABASE_PROVIDER=mysql
# DATABASE_URL="mysql://parrotype:parrotype@localhost:3306/parrotype"
