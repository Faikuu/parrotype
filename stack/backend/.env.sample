DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
CORS_ORIGINS=http://localhost:5173
PORT=3000
NODE_ENV=development
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (0 = none). Set to 1 behind a single proxy so
# the rate limiter keys on the client IP from X-Forwarded-For instead of the proxy's address.
TRUST_PROXY=0
