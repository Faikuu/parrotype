// GENERATED from prisma/schema.template.prisma by scripts/prisma-schema.mjs. Do not edit.
// Prisma schema for ParroType. This is the single source for every database engine.
// scripts/prisma-schema.mjs renders it into prisma/<provider>/schema.prisma; edit this file, not the copies.
// Migrations: prisma/<provider>/migrations, applied through `npm run prisma:migrate` / `npm run prisma:deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  /// name in lower case; usernames are unique regardless of case.
  nameLower    String   @unique
  email        String   @unique @db.VarChar(254)
  passwordHash String
  /// Bumped on logout. A session token carries the version it was issued with.
  tokenVersion Int      @default(0)
  /// "user" | "admin". Only granted through scripts/admin.ts; read from the database on every request.
  role         String   @default("user")
  /// Set by an admin ban. A banned user cannot log in and their sessions are rejected.
  bannedAt     DateTime?
  banReason    String?  @db.Text
  createdAt    DateTime @default(now())
  results      Result[]
  following       Follow[]  @relation("follower")
  followers       Follow[]  @relation("followee")
  reportsMade     Report[]  @relation("reporter")
  reportsReceived Report[]  @relation("target")
}

model Quote {
  id       Int    @id @default(autoincrement())
  language String // "en" | "pl" | "de" | "es"
  text     String @db.Text
  source   String @db.Text
  length   Int // text length in chars
  @@index([language])
}

model Result {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode           String // time|words|quote|zen|pangram|custom|daily|weak
  mode2          String // "15" | "60" | "25" | "short" | "3" | "custom" | YYYY-MM-DD ...
  language       String
  wpm            Float
  rawWpm         Float
  accuracy       Float
  consistency    Float
  durationMs     Int
  correctChars   Int
  incorrectChars Int
  extraChars     Int
  missedChars    Int
  punctuation    Boolean
  numbers        Boolean
  createdAt      DateTime @default(now())
  @@index([userId, createdAt])
  @@index([mode, mode2, language, wpm])
  // The badge's best wpm for one user and filter: a lookup on this index, not a scan of the group.
  @@index([userId, mode, mode2, language, wpm])
}

model Follow {
  followerId Int
  followeeId Int
  createdAt  DateTime @default(now())
  follower   User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)
  @@id([followerId, followeeId])
  @@index([followeeId])
}

model Report {
  id         Int       @id @default(autoincrement())
  reporterId Int
  targetId   Int
  reason     String // "name" | "cheating" | "other"
  details    String?   @db.Text // at most 500 characters
  status     String    @default("open") // "open" | "resolved" | "dismissed"
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  reporter   User @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target     User @relation("target", fields: [targetId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
}

/// Audit log of admin and CLI actions. No relation to User, so entries outlive deleted admins.
model AdminAction {
  id        Int      @id @default(autoincrement())
  adminId   Int?     // null for CLI actions and for admins who were deleted later
  action    String   // "ban" | "unban" | "delete_result" | "resolve_report" | "dismiss_report" | "grant_admin" | "revoke_admin"
  target    String   // e.g. "user:42", "result:9", "report:3"
  note      String?  @db.Text
  createdAt DateTime @default(now())
  @@index([createdAt])
}
