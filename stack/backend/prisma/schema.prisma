// Prisma schema for ParroType (SQLite).
// Migrations: npm run prisma:migrate (dev) / npm run prisma:deploy (prod).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  /// name in lower case; usernames are unique regardless of case.
  nameLower    String   @unique
  email        String   @unique
  passwordHash String
  /// Bumped on logout. A session token carries the version it was issued with.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  results      Result[]
}

model Quote {
  id       Int    @id @default(autoincrement())
  language String // "en" | "pl"
  text     String
  source   String
  length   Int // text length in chars
  @@index([language])
}

model Result {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode           String // time|words|quote|zen|pangram|custom
  mode2          String // "15" | "60" | "25" | "short" | "3" | "custom" ...
  language       String
  wpm            Float
  rawWpm         Float
  accuracy       Float
  consistency    Float
  durationMs     Int
  correctChars   Int
  incorrectChars Int
  extraChars     Int
  missedChars    Int
  punctuation    Boolean
  numbers        Boolean
  createdAt      DateTime @default(now())
  @@index([userId, createdAt])
  @@index([mode, mode2, language, wpm])
}
